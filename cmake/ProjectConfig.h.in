#ifndef PROJECT_CONFIG_H
#define PROJECT_CONFIG_H

/* 应用信息 */
#define APP_NAME "@PROJECT_NAME@"
#define APP_REPOSITORY_URL "@APP_REPOSITORY_URL@"
#define APP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define APP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define APP_VERSION_PATCH @PROJECT_VERSION_PATCH @
#define APP_VERSION "@PROJECT_VERSION@"
#define CMAKE_BUILD_TYPE "@CMAKE_BUILD_TYPE@"
/* CMake 版本 */
#define CMAKE_MAJOR_VERSION @CMAKE_MAJOR_VERSION@
#define CMAKE_MINOR_VERSION @CMAKE_MINOR_VERSION@
#define CMAKE_PATCH_VERSION @CMAKE_PATCH_VERSION@
#define CMAKE_VERSION "@CMAKE_VERSION@"
/* 库 */
// Qt
#define QT_VERSION_MAJOR @QT_VERSION_MAJOR@
#define QT_VERSION_MINOR @QT_VERSION_MINOR@
#define QT_VERSION_PATCH @QT_VERSION_PATCH@
#define QT_VERSION "@QT_VERSION@"
/* 兼容判断变量 */
#define CMAKE_CXX_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@"
#define CMAKE_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@"
#define CMAKE_CXX_STANDARD "@CMAKE_CXX_STANDARD@"
#define CMAKE_HOST_SYSTEM_NAME "@CMAKE_HOST_SYSTEM_NAME@"
#define CMAKE_SYSTEM_VERSION "@CMAKE_SYSTEM_VERSION@"
#define CMAKE_HOST_SYSTEM_PROCESSOR "@CMAKE_HOST_SYSTEM_PROCESSOR@"
#define CMAKE_SYSTEM_PROCESSOR "@CMAKE_SYSTEM_PROCESSOR@"
#define CMAKE_SIZEOF_VOID_P @CMAKE_SIZEOF_VOID_P@

#endif
